# Bu dosyayı .env.local olarak kopyala ve değerleri doldur:
#   cp .env.example .env.local
# .env.local git tarafından yok sayılır; gerçek anahtarları yalnızca oraya yaz.

# Resend API anahtarı — iletişim formunun e-posta gönderebilmesi için gerekli.
# https://resend.com/api-keys adresinden ücretsiz alınır.
# Tanımlı değilse form çökmez; /api/contact 503 "not_configured" döner.
RESEND_API_KEY=

# Gönderen adresi. Doğrulanmış bir alan adın yoksa boş bırak — kod Resend'in
# test adresine düşer ("Portföy <onboarding@resend.dev>"). Bu adres yalnızca
# Resend hesabının sahibi olan e-postaya teslim edebilir.
CONTACT_FROM=

# Mesajların düşeceği kutu. Boş bırakılırsa src/lib/data.ts içindeki
# personal.email kullanılır.
CONTACT_TO=
